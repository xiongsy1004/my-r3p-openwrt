#
# Target: Xiaomi Mi Router 3 Pro
#

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3-pro=y


#
# LuCI
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y


#
# Basic Network
#

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y


#
# Wireless / Multi SSID
#

CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y

CONFIG_PACKAGE_luci-app-wireless=y


#
# Firewall
#

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y


#
# VLAN / IoT isolation
#

CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-bridge=y

CONFIG_PACKAGE_luci-app-vlan=y


#
# DHCP / Relay
#

CONFIG_PACKAGE_luci-proto-relay=y


#
# mDNS / Home Assistant / Mi Home discovery
#

CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y


#
# PassWall2
#

CONFIG_PACKAGE_luci-app-passwall2=y

CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y

CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ipset6=y

CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y

CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_chinadns-ng=y


#
# DNS
#

CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y


#
# Geodata
#

CONFIG_PACKAGE_v2ray-geodata=y


#
# DDNS
#

CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y


#
# UPnP
#

CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y


#
# SSH
#

CONFIG_PACKAGE_dropbear=y


#
# USB
#

CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y


#
# System tools
#

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
