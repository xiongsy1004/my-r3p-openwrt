#
# Target System
#

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3-pro=y


#
# LuCI 中文界面
#

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-bootstrap=y


#
# 基础网络
#

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y


#
# WiFi / 多SSID / AP管理
#

CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y


#
# 防火墙
#

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_firewall4=y


#
# VLAN / IoT隔离
#

CONFIG_PACKAGE_kmod-8021q=y
CONFIG_PACKAGE_kmod-bridge=y

CONFIG_PACKAGE_luci-app-vlan=y


#
# 多SSID辅助
#

CONFIG_PACKAGE_luci-app-wireless=y


#
# mDNS (HA / 米家发现)
#

CONFIG_PACKAGE_avahi-daemon=y
CONFIG_PACKAGE_avahi-utils=y


#
# PassWall2
#

CONFIG_PACKAGE_luci-app-passwall2=y

CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y

CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_chinadns-ng=y

CONFIG_PACKAGE_kmod-tun=y


#
# DNS增强
#

CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y


#
# QoS（可选）
#

CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y


#
# DDNS
#

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y


#
# UPnP
#

CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y


#
# SSH
#

CONFIG_PACKAGE_dropbear=y


#
# USB支持（R3P有USB3.0）
#

CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_block-mount=y
